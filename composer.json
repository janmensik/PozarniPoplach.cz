{
    "require": {
        "php": ">=8.2",
        "smarty/smarty": "^5.4",
        "bramus/router": "^1.6",
        "casbin/casbin": "^4.5",
        "chillerlan/php-qrcode": "^6.0",
        "nette/utils": "^4.0",
        "vlucas/phpdotenv": "^5.6",
        "janmensik/jmlib": "^2.0",
        "machinateur/roman-numerals": "^1.2"
    },
    "require-dev": {
        "pestphp/pest": "^3.0"
    },
    "autoload": {
        "classmap": [
            "include/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2.33"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
