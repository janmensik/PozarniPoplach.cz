{
    "require": {
        "php": ">=8.2",
        "smarty/smarty": "^5.4",
        "bramus/router": "^1.6",
        "casbin/casbin": "^3.25",
        "chillerlan/php-qrcode": "^5.0",
        "getbrevo/brevo-php": "^2.0",
        "nette/utils": "^4.0",
        "php-imap/php-imap": "^5.0",
        "vlucas/phpdotenv": "^5.6",
        "janmensik/jmlib": "1.6.5",
        "machinateur/roman-numerals": "^1.2"
    },
    "require-dev": {
        "pestphp/pest": "^3.0"
    },
    "autoload": {
        "classmap": [
            "include/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
